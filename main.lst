119+  9FC9              ; ----------------------------------------------------------------------------------------
120+  9FC9              ; probe_cell - classify a candidate cell, remembering which cell it was so that
121+  9FC9              ;              destroy_brick can find it again.
122+  9FC9              ;   IN  - H = row, L = column
123+  9FC9              ;   OUT - A = CELL_*, HL = the cell's attribute address
124+  9FC9              ; ----------------------------------------------------------------------------------------
125+  9FC9              probe_cell:
126+  9FC9 22 5A 9F             ld (cand_cell), hl              ; byte 0 = column (L), byte 1 = row (H)
127+  9FCC C3 CF 9F             jp classify_cell
128+  9FCF
129+  9FCF              ; ----------------------------------------------------------------------------------------
130+  9FCF              ; classify_cell - what is at a cell?
131+  9FCF              ;   IN  - H = row (0..23), L = column (0..31)
132+  9FCF              ;   OUT - A = CELL_*, HL = that cell's attribute address
133+  9FCF              ;   Clobbers AF, HL. Preserves BC, DE, IX.
134+  9FCF              ;
135+  9FCF              ; The tests are range comparisons (jr nc), not the exact-equality tests the ball used to
136+  9FCF              ; use. Equality was only safe while the step was exactly +/-1; with fractional velocities
137+  9FCF              ; that assumption is gone.
138+  9FCF              ; ----------------------------------------------------------------------------------------
139+  9FCF              classify_cell:
140+  9FCF 7C                   ld a, h
141+  9FD0 FE 17                cp 23
142+  9FD2 30 20                jr nc, cc_paddlerow             ; row 23 or beyond: the paddle's row
143+  9FD4 B7                   or a
144+  9FD5 28 18                jr z, cc_border                 ; row 0: top border
145+  9FD7 7D                   ld a, l
146+  9FD8 B7                   or a
147+  9FD9 28 14                jr z, cc_border                 ; column 0: left border
148+  9FDB FE 1F                cp 31
149+  9FDD 30 10                jr nc, cc_border                ; column 31 or beyond: right border
150+  9FDF
151+  9FDF                      ; interior: now the attribute can be trusted, because position has already
152+  9FDF                      ; ruled out the paddle and the border.
153+  9FDF CD 3D 9F             call PosXY
154+  9FE2 7E                   ld a, (hl)
155+  9FE3 B7                   or a
156+  9FE4 C8                   ret z                           ; A = 0 = CELL_EMPTY
157+  9FE5 FE 78                cp $78                          ; colour 8's rendered attribute -- PintarMapa.asm
158+  9FE7 28 03                jr z, cc_hard
159+  9FE9 3E 02                ld a, CELL_BRICK
160+  9FEB C9                   ret
161+  9FEC              cc_hard:
162+  9FEC 3E 03                ld a, CELL_HARD
163+  9FEE C9                   ret
164+  9FEF              cc_border:
165+  9FEF 3E 01                ld a, CELL_BORDER
166+  9FF1 C3 3D 9F             jp PosXY                        ; PosXY preserves AF
167+  9FF4              cc_paddlerow:
168+  9FF4 3E 04                ld a, CELL_PADDLEROW
169+  9FF6 C3 3D 9F             jp PosXY
170+  9FF9
171+  9FF9              ; ----------------------------------------------------------------------------------------
172+  9FF9              ; destroy_if_brick - clear the probed cell only if it was destructible.
173+  9FF9              ;   IN  - A = the class probe_cell returned
174+  9FF9              ;   Colour 8 (CELL_HARD) bounces the ball and is deliberately left alone. Get that wrong
175+  9FF9              ;   and bricks_left never reaches zero, so the level never completes.
176+  9FF9              ;   Clobbers AF, DE, HL.
177+  9FF9              ; ----------------------------------------------------------------------------------------
178+  9FF9              destroy_if_brick:
179+  9FF9 FE 02                cp CELL_BRICK
180+  9FFB C0                   ret nz
181+  9FFC                      ; fall through
182+  9FFC
183+  9FFC              ; ----------------------------------------------------------------------------------------
184+  9FFC              ; destroy_brick - clear BOTH cells of the brick at cand_cell and count it once.
185+  9FFC              ;
186+  9FFC              ; A brick is 2 cells wide and entry i of a row occupies columns 1+2i and 2+2i. So an ODD
187+  9FFC              ; column is the brick's LEFT cell and its partner is on the right; an EVEN column is the
188+  9FFC              ; RIGHT cell and its partner is on the left. One brick, two cells, ONE decrement.
189+  9FFC              ;   Clobbers AF, DE, HL.
190+  9FFC              ; ----------------------------------------------------------------------------------------
191+  9FFC              destroy_brick:
192+  9FFC 3A 5A 9F             ld a, (cand_cell)               ; column
193+  9FFF 6F                   ld l, a
194+  A000 3A 5B 9F             ld a, (cand_cell+1)             ; row
195+  A003 67                   ld h, a
196+  A004 E5                   push hl
197+  A005 CD 3D 9F             call PosXY
198+  A008 36 00                ld (hl), 0                      ; the cell the ball actually hit
199+  A00A E1                   pop hl
200+  A00B CB 45                bit 0, l
201+  A00D 28 03                jr z, db_even
202+  A00F 2C                   inc l                           ; odd column  -> left cell  -> partner to the right
203+  A010 18 01                jr db_partner
204+  A012              db_even:
205+  A012 2D                   dec l                           ; even column -> right cell -> partner to the left
206+  A013              db_partner:
207+  A013 CD 3D 9F             call PosXY
208+  A016 36 00                ld (hl), 0
209+  A018
210+  A018 21 57 9F             ld hl, bricks_left
211+  A01B 7E                   ld a, (hl)
212+  A01C B7                   or a
213+  A01D C8                   ret z                           ; already zero: never wrap round to 255
214+  A01E 35                   dec (hl)
215+  A01F C9                   ret
216+  A020
217+  A020              ; ----------------------------------------------------------------------------------------
218+  A020              ; paddle_hit - the ball reached row 23.
219+  A020              ;
220+  A020              ; POSICION byte 0 is the paddle's leftmost column, so the paddle spans
221+  A020              ; POSICION .. POSICION+6 and subtracting gives the hit index 0-6: three cells left of
222+  A020              ; centre, centre, three right. Where on the paddle the ball lands is what sets the rebound
223+  A020              ; angle -- without that the player has no influence on the trajectory at all, and whether
224+  A020              ; a level can be cleared would be fixed before anyone pressed a key.
225+  A020              ;
226+  A020              ;   IN  - NewCol+1 = the column the ball is heading for
227+  A020              ;   Clobbers AF, DE, HL.
228+  A020              ; ----------------------------------------------------------------------------------------
229+  A020              paddle_hit:
230+  A020 3A DB 9E             ld a, (NewCol+1)                ; the column the ball is heading for
231+  A023 21 0E 9B             ld hl, POSICION
232+  A026 96                   sub (hl)                        ; hit index = ball column - paddle left column
233+  A027 FE 07                cp LONGITUDPALA
234+  A029 30 2D                jr nc, ph_missed                ; unsigned, so this also catches "left of it"
235+  A02B
236+  A02B F5                   push af                         ; keep the index for the centre test below
237+  A02C 87                   add a, a
238+  A02D 87                   add a, a                        ; x4: each table entry is two 16-bit words
239+  A02E 5F                   ld e, a
240+  A02F 16 00                ld d, 0
241+  A031 21 C1 A0             ld hl, rebound_table
242+  A034 19                   add hl, de
243+  A035 5E                   ld e, (hl)
244+  A036 23                   inc hl
245+  A037 56                   ld d, (hl)
246+  A038 ED 53 D4 9E          ld (Vector), de                 ; row velocity, always upward
247+  A03C 23                   inc hl
248+  A03D 5E                   ld e, (hl)
249+  A03E 23                   inc hl
250+  A03F 56                   ld d, (hl)                      ; DE = column velocity from the table
251+  A040 F1                   pop af
252+  A041
253+  A041 FE 03                cp 3                            ; dead centre?
254+  A043 20 0E                jr nz, ph_store
255+  A045                      ; The exact middle of the paddle keeps the ball's current horizontal direction
256+  A045                      ; rather than forcing one, so the centre cell is not arbitrarily biased one way.
257+  A045 2A D6 9E             ld hl, (Vector+2)
258+  A048 CB 7C                bit 7, h
259+  A04A 28 07                jr z, ph_store                  ; was moving right: the table entry is already +
260+  A04C 7A                   ld a, d                         ; was moving left: mirror it
261+  A04D 2F                   cpl
262+  A04E 57                   ld d, a
263+  A04F 7B                   ld a, e
264+  A050 2F                   cpl
265+  A051 5F                   ld e, a
266+  A052 13                   inc de
267+  A053              ph_store:
268+  A053 ED 53 D6 9E          ld (Vector+2), de
269+  A057 C9                   ret
270+  A058
271+  A058              ph_missed:
272+  A058                      ; The paddle was not under the ball: the ball is lost. The floor used to bounce
273+  A058                      ; unconditionally, which is precisely what made the game impossible to lose.
274+  A058                      ;
275+  A058                      ; Only a FLAG is set here. Jumping to a game-over screen from inside the ball's
276+  A058                      ; collision code would abandon everything already on the stack, which is the same
277+  A058                      ; mistake the old F key made (teclado called Fin_Juego, which never came back).
278+  A058                      ; The frame loop in Partida.asm reads the flag and acts, where it can do so
279+  A058                      ; without unbalancing anything.
280+  A058 3E 01                ld a, 1
281+  A05A 32 59 9F             ld (ball_lost), a
282+  A05D C3 A5 A0             jp flip_row_velocity    ; bounce anyway, so this frame still ends somewhere legal
283+  A060
284+  A060              ; ----------------------------------------------------------------------------------------
285+  A060              ; reset_ball - back to the serve position, travelling up and to the right.
286+  A060              ;   Clobbers AF, HL.
287+  A060              ; ----------------------------------------------------------------------------------------
288+  A060              reset_ball:
289+  A060 3E 10                ld a, BALL_START_COL
290+  A062 32 D0 9E             ld (Coord), a
291+  A065 3E 14                ld a, BALL_START_ROW
292+  A067 32 D1 9E             ld (Coord+1), a
293+  A06A AF                   xor a
294+  A06B 32 D2 9E             ld (CoordFrac), a
295+  A06E 32 D3 9E             ld (CoordFrac+1), a
296+  A071                      ; 45 degrees up and to the right, at the SAME magnitude as every rebound_table
297+  A071                      ; entry: |(-181,181)| = 256 = one cell per frame of travel. Serving at
298+  A071                      ; (-256,+256) instead would be |v| = 362, i.e. 41% faster than the ball can ever
299+  A071                      ; travel after touching the paddle, so it would visibly slow down for good on
300+  A071                      ; first contact.
301+  A071 21 4B FF             ld hl, -181
302+  A074 22 D4 9E             ld (Vector), hl
303+  A077 21 B5 00             ld hl, 181
304+  A07A 22 D6 9E             ld (Vector+2), hl
305+  A07D C9                   ret
306+  A07E
307+  A07E              ; ----------------------------------------------------------------------------------------
308+  A07E              ; reset_round - ball and paddle back to their start positions.
309+  A07E              ;   Used on level change AND after losing a ball. Bricks and lives are left alone.
310+  A07E              ;   Nothing in this game reset anything before: a new level began with the ball wherever
311+  A07E              ;   it happened to be, and a second game started with everything where the first ended.
312+  A07E              ;   Clobbers AF, HL.
313+  A07E              ; ----------------------------------------------------------------------------------------
314+  A07E              reset_round:
315+  A07E CD 60 A0             call reset_ball
316+  A081                      ; Erase the paddle where it is RIGHT NOW, immediately, instead of recording a
317+  A081                      ; pending erase in POSICION+1 for dibujarpala to pick up later.
318+  A081                      ;
319+  A081                      ; POSICION+1 is a single-slot pending erase written by BOTH nuevaposicion and
320+  A081                      ; this routine, and consumed only by dibujarpala. On the frame a ball is lost
321+  A081                      ; the loop leaves via `jp Ball_Lost`, so dibujarpala never runs that frame --
322+  A081                      ; and on the next frame nuevaposicion overwrites POSICION+1 first, discarding
323+  A081                      ; the pending erase. The old paddle then stayed painted, and every later move
324+  A081                      ; only erased one column behind, so the leftovers survived on screen.
325+  A081                      ; Erasing here means a pending erase never has to survive a frame boundary.
326+  A081 3A 0E 9B             ld a, (POSICION)
327+  A084 0E 00                ld c, 0
328+  A086 CD 24 9B             call dibujarpalacolor
329+  A089 3E 0E                ld a, PADDLE_START
