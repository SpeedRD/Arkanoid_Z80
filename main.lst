366+  A0B9              negate_hl:
367+  A0B9 7C                   ld a, h
368+  A0BA 2F                   cpl
369+  A0BB 67                   ld h, a
370+  A0BC 7D                   ld a, l
371+  A0BD 2F                   cpl
372+  A0BE 6F                   ld l, a
373+  A0BF 23                   inc hl
374+  A0C0 C9                   ret
375+  A0C1
376+  A0C1              ; ----------------------------------------------------------------------------------------
377+  A0C1              ; Rebound angles, indexed by where on the 7-cell paddle the ball landed.
378+  A0C1              ;
379+  A0C1              ; Centre sends the ball steeply up, the edges send it out shallow and wide -- the classic
380+  A0C1              ; Arkanoid feel. Both components are 8.8 fixed point, and the table obeys the two hard
381+  A0C1              ; invariants: every row velocity is NON-ZERO (a horizontal ball never comes back and the
382+  A0C1              ; game live-locks), and no magnitude exceeds $0100 = one cell per frame (or the ball skips
383+  A0C1              ; cells and can pass straight through a brick).
384+  A0C1              ; ----------------------------------------------------------------------------------------
385+  A0C1              ; SPEED IS CONSTANT. Every entry has |v| = 256 +/- 1, i.e. exactly one cell per frame of
386+  A0C1              ; travel, and reset_ball serves at the same magnitude. Only the DIRECTION varies.
387+  A0C1              ;
388+  A0C1              ; This is the whole point and it is easy to get wrong: a rebound must change where the
389+  A0C1              ; ball is going without changing how fast it is going. The first version of this table
390+  A0C1              ; varied from 250 to 286 and, worse, the serve was 362 (-1.00,+1.00 at 45 degrees) -- so
391+  A0C1              ; the ball was launched 26-45% faster than any rebound could ever return it, and dropped
392+  A0C1              ; to walking pace the instant it first touched the paddle, permanently. Wall and brick
393+  A0C1              ; bounces only negate a component, so they preserve whatever magnitude they are given and
394+  A0C1              ; the ball never recovered.
395+  A0C1              ;
396+  A0C1              ; 256 is the ceiling: no single component may exceed $0100 (one cell per axis per frame)
397+  A0C1              ; or the ball skips cells, and the shallowest entries here are already at 222.
398+  A0C1              ;
399+  A0C1              ;                row velocity     column velocity    angle from vertical
400+  A0C1              rebound_table:
401+  A0C1 80 FF                DW -128
401+  A0C3 22 FF          DW -222          ; 0  far left     60 deg  -- shallow, hard left
402+  A0C5 4B FF                DW -181
402+  A0C7 4B FF          DW -181          ; 1               45 deg
403+  A0C9 22 FF                DW -222
403+  A0CB 80 FF          DW -128          ; 2               30 deg
404+  A0CD 08 FF                DW -248
404+  A0CF 40 00          DW   64          ; 3  centre       14 deg  -- steep; sign follows the
405+  A0D1                                                  ;                            incoming ball
406+  A0D1 22 FF                DW -222
406+  A0D3 80 00          DW  128          ; 4               30 deg
407+  A0D5 4B FF                DW -181
407+  A0D7 B5 00          DW  181          ; 5               45 deg
408+  A0D9 80 FF                DW -128
408+  A0DB DE 00          DW  222          ; 6  far right    60 deg  -- shallow, hard right
409+  A0DD
