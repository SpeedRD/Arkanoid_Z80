  1+  9E7A 00           levelCounter: DEFB 0     ; Para contar los niveles que van pasando
  2+  9E7B              CantidadNiveles: EQU 4
  3+  9E7B
  4+  9E7B              Juego:
  5+  9E7B CD 7C 9B         call dibujar_tablero
  6+  9E7E CD A9 9B         call Mostrar_Mapa
  7+  9E81
  8+  9E81              Pala_Juego:
  9+  9E81 CD DD 9E         call ball
 10+  9E84
 11+  9E84                  ; mirar si fin partida: el nivel termina cuando cae el ultimo ladrillo
 12+  9E84                  ; destructible. Se comprueba aqui, dentro del bucle de frame, y NO desde
 13+  9E84                  ; teclado: Fin_Juego no vuelve, asi que tiene que ser jp y no call.
 14+  9E84 3A 57 9F         ld a, (bricks_left)
 15+  9E87 B7               or a
 16+  9E88 CA B7 9E         jp z, Fin_Juego
 17+  9E8B
 18+  9E8B                  ; La pala ha fallado la bola. Igual que arriba: jp, nunca call.
 19+  9E8B 3A 59 9F         ld a, (ball_lost)
 20+  9E8E B7               or a
 21+  9E8F C2 A0 9E         jp nz, Ball_Lost
 22+  9E92
 23+  9E92 CD 32 9B         call teclado
 24+  9E95 CD 5C 9B         call nuevaposicion
 25+  9E98 CD 10 9B         call dibujarpala
 26+  9E9B CD 73 9B         call esperar
 27+  9E9E 18 E1            jr Pala_Juego
 28+  9EA0
 29+  9EA0
 30+  9EA0              ; ----------------------------------------------------------------------------------------
 31+  9EA0              ; Ball_Lost - una vida menos. Si quedan vidas se sirve otra bola en el mismo nivel, con
 32+  9EA0              ; los ladrillos como estaban; si no, se acaba la partida. Se entra aqui con jp desde el
 33+  9EA0              ; bucle de frame, asi que la pila sigue equilibrada.
 34+  9EA0              ; ----------------------------------------------------------------------------------------
 35+  9EA0              Ball_Lost:
 36+  9EA0 AF               xor a
 37+  9EA1 32 59 9F         ld (ball_lost), a
 38+  9EA4 21 58 9F         ld hl, lives
 39+  9EA7 35               dec (hl)
 40+  9EA8 CA B1 9E         jp z, Game_Over
 41+  9EAB
 42+  9EAB CD 7E A0         call reset_round     ; nueva bola y pala al centro; los ladrillos no se tocan
 43+  9EAE C3 81 9E         jp Pala_Juego
 44+  9EB1
 45+  9EB1              ; ----------------------------------------------------------------------------------------
 46+  9EB1              ; Game_Over - derrota. Es un camino DISTINTO de ReinicioJuego: aquel es la pantalla de
 47+  9EB1              ; partida COMPLETADA, a la que se llega contando cuatro cambios de nivel. Perder y ganar
 48+  9EB1              ; no son lo mismo y no comparten mensaje.
 49+  9EB1              ; ----------------------------------------------------------------------------------------
 50+  9EB1              Game_Over:
 51+  9EB1 CD 95 A0         call reset_game
 52+  9EB4 C3 30 9A         jp Pantalla_GameOver
 53+  9EB7
 54+  9EB7              Fin_Juego:
 55+  9EB7 11 01 00         ld de, 1
 56+  9EBA DD 19            add ix, de           ; Sumamos a IX (maplist) para pasar al siguiente mapa
 57+  9EBC
 58+  9EBC                  ; Incrementar levelCounter
 59+  9EBC                  ; OJO: el incremento va ANTES de comparar. Invertir el orden hace que tras el
 60+  9EBC                  ; ultimo mapa se lea levelCounter y codigo ejecutable como si fueran datos de mapa.
 61+  9EBC 21 7A 9E         ld hl, levelCounter
 62+  9EBF 34               inc (hl)
 63+  9EC0 7E               ld a, (hl)           ; Cargar el valor incrementado a levelCounter
 64+  9EC1 FE 04            cp CantidadNiveles     ; Comparar con el numero maximo de niveles (4)
 65+  9EC3 28 05            jr z, ReinicioJuego  ; Si alcanzamos el maximo, ir a ReinicioJuego
 66+  9EC5
 67+  9EC5 CD 7E A0         call reset_round     ; bola y pala al inicio para el nivel nuevo
 68+  9EC8 18 B1            jr Juego             ; Continuar con el juego
 69+  9ECA
 70+  9ECA              ReinicioJuego:
 71+  9ECA CD 95 A0         call reset_game      ; vidas, contador de nivel, bola y pala
 72+  9ECD
 73+  9ECD                  ; JP, no CALL, por lo mismo que flujo_juego -> Juego: Pantalla_Reinicio no vuelve
 74+  9ECD                  ; nunca (acaba en jp flujo_juego), asi que con CALL se abandonaba la direccion de
 75+  9ECD                  ; retorno en la pila -- medido: 2 bytes por partida completa. Ademas aqui no hay
 76+  9ECD                  ; nada detras: Partida.asm se acaba en esta linea y lo siguiente en la imagen son
 77+  9ECD                  ; los datos de pelota.asm, asi que si alguna vez volviera se ejecutarian Coord y
 78+  9ECD                  ; Vector como si fueran codigo. Con jp eso es imposible por construccion.
 79+  9ECD C3 03 9A         jp Pantalla_Reinicio
