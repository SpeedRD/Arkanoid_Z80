  1+  9F57              ; ----------------------------------------------------------------------------------------
  2+  9F57              ; Collisions.
  3+  9F57              ;
  4+  9F57              ; The ball is one attribute cell and moves at most one cell per axis per frame, so a
  5+  9F57              ; collision is a cell lookup, not a box intersection. Everything here classifies the cell
  6+  9F57              ; the ball is about to move into and reacts.
  7+  9F57              ;
  8+  9F57              ; Classification is BY POSITION FIRST, attribute second, because attribute values are
  9+  9F57              ; ambiguous: $10 is both the paddle and a colour-2 brick, $38 is both the ball and a
 10+  9F57              ; colour-7 brick, and $00 is both an empty cell and a destroyed one.
 11+  9F57              ; ----------------------------------------------------------------------------------------
 12+  9F57
 13+  9F57              CELL_EMPTY      EQU 0       ; nothing there
 14+  9F57              CELL_BORDER     EQU 1       ; the frame drawn by dibujar_tablero
 15+  9F57              CELL_BRICK      EQU 2       ; destructible, colours 1-7
 16+  9F57              CELL_HARD       EQU 3       ; colour 8, indestructible (rendered as $78 -- PintarMapa.asm)
 17+  9F57              CELL_PADDLEROW  EQU 4       ; row 23, where the paddle lives
 18+  9F57
 19+  9F57              INITIAL_LIVES   EQU 3
 20+  9F57              BALL_START_ROW  EQU 20
 21+  9F57              BALL_START_COL  EQU 16
 22+  9F57              PADDLE_START    EQU 14      ; POSICION's own initial value
 23+  9F57
 24+  9F57 00           bricks_left:    DB 0        ; destructible bricks still standing. Loaded from the map's
 25+  9F58                                          ; byte 0 by Mostrar_Mapa; the level ends when it reaches 0.
 26+  9F58 03           lives:          DB INITIAL_LIVES    ; reset per GAME, never per level. The DB only runs
 27+  9F59                                          ; once per LOAD, so reset_game has to set it explicitly.
 28+  9F59 00           ball_lost:      DB 0        ; set when the paddle missed; the frame loop acts on it
 29+  9F5A 00 00        cand_cell:      DW 0        ; the cell probe_cell last looked at: byte 0 = column, 1 = row
 30+  9F5C 00           bounce_flags:   DB 0        ; bit 0 = row velocity flipped, bit 1 = column velocity flipped
 31+  9F5D
 32+  9F5D              ; ----------------------------------------------------------------------------------------
 33+  9F5D              ; resolve_collisions - decide what the ball hit and bounce it.
 34+  9F5D              ;
 35+  9F5D              ; Three candidate cells, tested in this order. It is the standard resolution and it is what
 36+  9F5D              ; a player expects:
 37+  9F5D              ;     vertical   = (new row, old column)  -> flip the row velocity
 38+  9F5D              ;     horizontal = (old row, new column)  -> flip the column velocity
 39+  9F5D              ;     diagonal   = (new row, new column)  -> only when neither orthogonal cell was solid;
 40+  9F5D              ;                                            flip both. The corner clip is genuinely
 41+  9F5D              ;                                            ambiguous; this convention is deterministic
 42+  9F5D              ;                                            and symmetric, so it stays consistent.
 43+  9F5D              ;
 44+  9F5D              ; Two bricks CAN be destroyed in one frame (vertical and horizontal both hit). That is
 45+  9F5D              ; correct, and the counter is decremented twice.
 46+  9F5D              ;
 47+  9F5D              ; After any flip the position is re-derived by calling step_ball again, so the ball moves
 48+  9F5D              ; with the NEW velocity. That is also why a destroyed brick is never restored underneath
 49+  9F5D              ; the ball: the ball always ends up moving AWAY from whatever it just hit, so its final
 50+  9F5D              ; cell is never a cell this routine cleared.
 51+  9F5D              ;
 52+  9F5D              ;   IN  - NewRow/NewCol from step_ball, Coord = the cell the ball is leaving
 53+  9F5D              ;   OUT - Vector possibly changed, NewRow/NewCol re-derived
 54+  9F5D              ;   Clobbers AF, DE, HL. Preserves BC, IX.
 55+  9F5D              ; ----------------------------------------------------------------------------------------
 56+  9F5D              resolve_collisions:
 57+  9F5D AF                   xor a
 58+  9F5E 32 5C 9F             ld (bounce_flags), a
 59+  9F61
 60+  9F61                      ; ---- vertical candidate: (tentative row, current column) ----------
 61+  9F61 3A D9 9E             ld a, (NewRow+1)
 62+  9F64 67                   ld h, a
 63+  9F65 3A D0 9E             ld a, (Coord)
 64+  9F68 6F                   ld l, a
 65+  9F69 CD C9 9F             call probe_cell
 66+  9F6C B7                   or a
 67+  9F6D 28 19                jr z, rc_horizontal             ; CELL_EMPTY
 68+  9F6F FE 04                cp CELL_PADDLEROW
 69+  9F71 28 0D                jr z, rc_paddle
 70+  9F73 CD F9 9F             call destroy_if_brick
 71+  9F76 CD A5 A0             call flip_row_velocity
 72+  9F79 21 5C 9F             ld hl, bounce_flags
 73+  9F7C CB C6                set 0, (hl)
 74+  9F7E 18 08                jr rc_horizontal
 75+  9F80
 76+  9F80              rc_paddle:
 77+  9F80 CD 20 A0             call paddle_hit                 ; sets both velocities when it catches
 78+  9F83 21 5C 9F             ld hl, bounce_flags
 79+  9F86 CB C6                set 0, (hl)
 80+  9F88
 81+  9F88              rc_horizontal:
 82+  9F88                      ; ---- horizontal candidate: (current row, tentative column) --------
 83+  9F88 3A D1 9E             ld a, (Coord+1)
 84+  9F8B 67                   ld h, a
 85+  9F8C 3A DB 9E             ld a, (NewCol+1)
 86+  9F8F 6F                   ld l, a
 87+  9F90 CD C9 9F             call probe_cell
 88+  9F93 B7                   or a
 89+  9F94 28 0B                jr z, rc_diagonal
 90+  9F96 CD F9 9F             call destroy_if_brick
 91+  9F99 CD AF A0             call flip_col_velocity
 92+  9F9C 21 5C 9F             ld hl, bounce_flags
 93+  9F9F CB CE                set 1, (hl)
 94+  9FA1
 95+  9FA1              rc_diagonal:
 96+  9FA1 3A 5C 9F             ld a, (bounce_flags)
 97+  9FA4 B7                   or a
 98+  9FA5 20 1F                jr nz, rc_restep                ; already resolved orthogonally
 99+  9FA7
100+  9FA7 3A D9 9E             ld a, (NewRow+1)
101+  9FAA 67                   ld h, a
102+  9FAB 3A DB 9E             ld a, (NewCol+1)
103+  9FAE 6F                   ld l, a
104+  9FAF CD C9 9F             call probe_cell
105+  9FB2 B7                   or a
106+  9FB3 C8                   ret z                           ; empty: the move stands, no re-step needed
107+  9FB4 FE 04                cp CELL_PADDLEROW
108+  9FB6 28 0B                jr z, rc_diag_paddle
109+  9FB8 CD F9 9F             call destroy_if_brick
110+  9FBB CD A5 A0             call flip_row_velocity
111+  9FBE CD AF A0             call flip_col_velocity
112+  9FC1 18 03                jr rc_restep
