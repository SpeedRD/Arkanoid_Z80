 35   9ED0                      INCLUDE "pelota.asm"
# file opened: pelota.asm
  1+  9ED0              ; ----------------------------------------------------------------------------------------
  2+  9ED0              ; Ball.
  3+  9ED0              ;
  4+  9ED0              ; The playfield IS the attribute file ($5800-$5AFF) and there is no background layer, so
  5+  9ED0              ; erasing the ball by writing 0 destroys whatever cell it was sitting on. That is why the
  6+  9ED0              ; ball used to chew holes through the bricks and the border without any collision code
  7+  9ED0              ; existing at all. This file therefore READS the attribute under the ball before drawing
  8+  9ED0              ; and writes that same byte back on erase.
  9+  9ED0              ;
 10+  9ED0              ; Position is 8.8 fixed point per axis. The whole part is the cell the ball occupies and
 11+  9ED0              ; lives in Coord; the fraction lives in CoordFrac. Velocity in Vector is signed 8.8 too.
 12+  9ED0              ; That is what lets the ball travel at angles other than 45 degrees while still advancing
 13+  9ED0              ; at most ONE cell per axis per frame -- so it can never step over a brick without
 14+  9ED0              ; touching it, and the range tests in classify_cell stay sound.
 15+  9ED0              ;
 16+  9ED0              ; Hard invariants:
 17+  9ED0              ;   * |velocity| on each axis must stay <= $0100 (one cell/frame), or the ball skips cells.
 18+  9ED0              ;   * the ROW velocity must never reach 0, or the ball never returns to the paddle.
 19+  9ED0              ; ----------------------------------------------------------------------------------------
 20+  9ED0
 21+  9ED0              ; Byte 0 is the COLUMN and byte 1 is the ROW. `ld hl,(Coord)` puts byte 0 in L, and PosXY
 22+  9ED0              ; takes H as the row -- so the ball starts at row 20, column 16. The comment that used to
 23+  9ED0              ; sit here said "(fila, columna)", which is backwards, and the one on Vector said "(X, Y)"
 24+  9ED0              ; when byte 0 was the row delta.
 25+  9ED0 10 14        Coord:      DB 16, 20       ; column, row -- the cell the ball occupies
 26+  9ED2 00 00        CoordFrac:  DB 0, 0         ; sub-cell fraction, same order: column, row
 27+  9ED4
 28+  9ED4              ; Signed 8.8 velocity: ROW at Vector, COLUMN at Vector+2. |(-181,181)| = 256, i.e. one
 29+  9ED4              ; cell per frame of travel -- the SAME magnitude as every rebound_table entry and as
 30+  9ED4              ; reset_ball. Keep it that way: this declaration is what the very first ball of a fresh
 31+  9ED4              ; load flies at, because inline DB/DW data is initialised once per LOAD and reset_ball
 32+  9ED4              ; does not run until the first level change or lost ball. It used to say (-256,256), so
 33+  9ED4              ; the first ball travelled at |v| = 362 and then dropped ~30% for good on first contact
 34+  9ED4              ; with the paddle.
 35+  9ED4 4B FF        Vector:     DW -181         ; ROW velocity    (negative = upward)
 36+  9ED6 B5 00                    DW  181         ; COLUMN velocity (positive = right)
 37+  9ED8
 38+  9ED8 00 00        NewRow:     DW 0            ; scratch: tentative row position this frame, 8.8
 39+  9EDA 00 00        NewCol:     DW 0            ; scratch: tentative column position this frame, 8.8
 40+  9EDC 00           BallSaved:  DB 0            ; the attribute that was under the ball before it drew
 41+  9EDD
 42+  9EDD              ; ----------------------------------------------------------------------------------------
 43+  9EDD              ; ball - advance, resolve collisions, draw, wait, restore. One frame.
 44+  9EDD              ;   IN  - reads Coord, CoordFrac, Vector
 45+  9EDD              ;   OUT - updates them
 46+  9EDD              ;   Clobbers AF, DE, HL. Preserves BC, IX, IY.
 47+  9EDD              ; ----------------------------------------------------------------------------------------
 48+  9EDD              ball:
 49+  9EDD CD 0F 9F             call step_ball          ; NewRow/NewCol = position + velocity
 50+  9EE0 CD 5D 9F             call resolve_collisions ; bounce / destroy; re-steps if it flipped anything
 51+  9EE3
 52+  9EE3                      ; --- commit the resolved position ---
 53+  9EE3 3A D9 9E             ld a, (NewRow+1)
 54+  9EE6 32 D1 9E             ld (Coord+1), a
 55+  9EE9 3A D8 9E             ld a, (NewRow)
 56+  9EEC 32 D3 9E             ld (CoordFrac+1), a
 57+  9EEF 3A DB 9E             ld a, (NewCol+1)
 58+  9EF2 32 D0 9E             ld (Coord), a
 59+  9EF5 3A DA 9E             ld a, (NewCol)
 60+  9EF8 32 D2 9E             ld (CoordFrac), a
 61+  9EFB
 62+  9EFB                      ; --- draw, wait, restore ---
 63+  9EFB 2A D0 9E             ld hl, (Coord)          ; L = column, H = row
 64+  9EFE CD 3D 9F             call PosXY              ; HL = attribute address
 65+  9F01 7E                   ld a, (hl)
 66+  9F02 32 DC 9E             ld (BallSaved), a       ; whatever was here before the ball landed on it
 67+  9F05 36 38                ld (hl), 8*7            ; white paper
 68+  9F07 CD 30 9F             call Esperar_pelota     ; preserves HL
 69+  9F0A 3A DC 9E             ld a, (BallSaved)
