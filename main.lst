# file opened: main.asm
  1   0000                      DEVICE ZXSPECTRUM48
  2   0000              	SLDOPT COMMENT WPMEM, LOGPOINT, ASSERTION
  3   0000                      org $8000               ; Programa ubicado a partir de $8000 = 32768
  4   8000
  5   8000 F3                   di              ; Deshabilitar interrupciones
  6   8001 31 00 00             ld sp,0         ; Establecer el puntero de pila en la parte alta de la memoria
  7   8004
  8   8004              ;-------------------------------------------------------------------------------------------------
  9   8004              ;Código del estudiante
 10   8004
 11   8004 CD 11 80             CALL Main_Pantalla    ;Pantalla de Titulo
 12   8007              empezar:
 13   8007 CD E8 99             CALL Pantalla_Ini
 14   800A
 15   800A              flujo_juego:
 16   800A
 17   800A DD 2A E8 9B          ld ix, (maplist)
 18   800E
 19   800E                      ; JP, no CALL. Juego no vuelve nunca: Partida.asm no contiene ni un solo RET,
 20   800E                      ; y todas sus salidas son jp/jr a sitios que tampoco vuelven (Pantalla_Reinicio
 21   800E                      ; y Pantalla_GameOver acaban las dos en jp flujo_juego). Con CALL, la direccion
 22   800E                      ; de retorno se abandonaba en la pila en cada partida -- medido: 2 bytes por
 23   800E                      ; reinicio. El "jr flujo_juego" que habia aqui detras era inalcanzable por el
 24   800E                      ; mismo motivo.
 25   800E C3 7B 9E             JP Juego
 26   8011
 27   8011                      INCLUDE "Pantalla_Inicio.asm"
