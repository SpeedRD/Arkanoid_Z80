 28   9664                      INCLUDE "L30.3 - printat.asm"
# file opened: L30.3 - printat.asm
  1+  9664              ; -------------------------------
  2+  9664              ; ZX Spectrum Text print library
  3+  9664              ; Daniel León - AOC - UFV 2020
  4+  9664              ; -------------------------------
  5+  9664
  6+  9664
  7+  9664              ; ----------------------------------------------------------------------------------------
  8+  9664              ; PRINTAT - Print a string in a position and attributes as per registers:
  9+  9664              ;		IN	A	: Bit 7=1 For Flash / Bit 6=1 For Brigh / Bit 5,4,3 for Paper / Bit 2,1,0 for Ink
 10+  9664              ;		IN	B	: Row 0..23
 11+  9664              ;		IN	C	: Column 0..31
 12+  9664              ;		IN	IX	: Address of text (Text must end in a 0)
 13+  9664              ; ----------------------------------------------------------------------------------------
 14+  9664 CD 73 96     PRINTAT:	CALL PREP_PRT				; Update Attribute var &Screen & Attributes pointers
 15+  9667              ; ----------------------------------------------------------------------------------------
 16+  9667              ;		VVV Do not move PRINTSTR below as PRINTAT continues into PRINTSTR routine
 17+  9667              ; ----------------------------------------------------------------------------------------
 18+  9667              ; PRINTSTR - Prints String - IX Points to the String start
 19+  9667              ; ----------------------------------------------------------------------------------------
 20+  9667 DD 7E 00     PRINTSTR:   LD A,(IX)					; A Contains first char to print
 21+  966A B7           			OR A						; check for end of string (0)
 22+  966B C8           			RET Z						; Finish printing if 0
 23+  966C CD A1 96     			CALL PRINTCHNUM
 24+  966F DD 23        			INC IX						; Move to next char in string
 25+  9671 18 F4        			JR PRINTSTR					; Start over printing sequence
 26+  9673              ; ----------------------------------------------------------------------------------------
 27+  9673
 28+  9673
 29+  9673              ;-----------------------------------------------------------------------------------------
 30+  9673              ; PREP_PRT - Updates Print_Attr, SCR & ATTR Vars
 31+  9673              ;-----------------------------------------------------------------------------------------
 32+  9673 32 E7 96     PREP_PRT:	LD (PRINT_ATTR),A			; Set Attribute
 33+  9676 CD 7C 96     PREP_PRT_2:	CALL CRtoSCREEN
 34+  9679 C3 8E 96     			JP CRtoATTR
 35+  967C              ;-----------------------------------------------------------------------------------------
 36+  967C
 37+  967C              ;-----------------------------------------------------------------------------------------
 38+  967C              ; CRtoSCREEN - Converts a scr char coord into a SCREEN Address   b,c = y,x positions
 39+  967C              ;	IN  - B=Row, C=Column
 40+  967C              ;	OUT - HL=Address in screen also stored in (SCR_CUR_PTR)
 41+  967C              ;	Conversion:
 42+  967C              ;			Row FFfff   Column CCCCC
 43+  967C              ;			HL=%010FF000 fffCCCCC
 44+  967C              ;-----------------------------------------------------------------------------------------
 45+  967C              CRtoSCREEN:
 46+  967C 78           			LD A,B						; %___FFfff
 47+  967D F6 40        			OR #40						; %010FFfff
 48+  967F E6 F8        			AND #F8						; %010FF000
 49+  9681 67           			LD H,A
 50+  9682
 51+  9682 78           			LD A,B						; %___FFfff
 52+  9683 E6 07        			AND #7						; %00000fff
 53+  9685 0F           			RRCA						; %f00000ff
 54+  9686 0F           			RRCA						; %ff00000f
 55+  9687 0F           			RRCA						; %fff00000
 56+  9688 B1           			OR C						; %fffCCCCC
 57+  9689 6F           			LD L,A
 58+  968A 22 E3 96                 LD (SCR_CUR_PTR),HL			; Update Variable
 59+  968D C9                       RET
 60+  968E              ; ----------------------------------------------------------------------------------------
 61+  968E
 62+  968E
 63+  968E
 64+  968E              ;-----------------------------------------------------------------------------------------
 65+  968E              ; CRtoATTR - Converts a screen char coord  into a ATTR Address  b,c = y,x positions
 66+  968E              ;	IN  - B=Row, C=Column
 67+  968E              ;	OUT - HL=Address in screen also stored in (SCR_ATTR_PTR)
 68+  968E              ;	Conversion:
 69+  968E              ;			Row FFfff   Column CCCCC
 70+  968E              ;			HL=%010110FF fffCCCCC
 71+  968E              ;-----------------------------------------------------------------------------------------
